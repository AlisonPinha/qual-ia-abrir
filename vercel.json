{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/entrega.mjs": {
      "includeFiles": "_private/**",
      "maxDuration": 10
    },
    "api/cakto.mjs": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/cola",
      "destination": "/materia",
      "permanent": false
    },
    {
      "source": "/bio",
      "destination": "https://diagnostico.noahai.com.br/?utm_source=instagram&utm_medium=organic_social&utm_campaign=qual_ia_usar&utm_content=link_bio",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "qual-ia-abrir.vercel.app"
        }
      ],
      "destination": "https://diagnostico.noahai.com.br/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "qual-ia-abrir.vercel.app"
        }
      ],
      "destination": "https://diagnostico.noahai.com.br/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/mapa",
      "destination": "/api/entrega?produto=mapa"
    },
    {
      "source": "/plano",
      "destination": "/api/entrega?produto=plano"
    }
  ]
}
